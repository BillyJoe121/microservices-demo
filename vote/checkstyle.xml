<?xml version="1.0"?>
<!DOCTYPE module PUBLIC
          "-//Checkstyle//DTD Checkstyle Configuration 1.3//EN"
          "https://checkstyle.org/dtds/configuration_1_3.dtd">

<module name="Checker">
  <!-- Permissive configuration for academic demo -->
  <property name="fileExtensions" value="java, properties, xml"/>

  <!-- Disable checks for newlines at end of file -->
  <!-- <module name="NewlineAtEndOfFile"/> - Removing this disables it -->

  <!-- Disable checks for Tabs -->
  <!-- <module name="FileTabCharacter"/> - Removing this disables it -->

  <module name="TreeWalker">
    <!-- Basic checks that are usually helpful but not annoying -->
    <module name="AvoidStarImport"/>
    <module name="EmptyBlock"/>
    <module name="EmptyCatchBlock">
       <property name="exceptionVariableName" value="expected|ignore"/>
    </module>
    <module name="NeedBraces"/>
    <module name="LeftCurly"/>
    <module name="RightCurly"/>
    <module name="UnusedImports"/>
    
    <!-- EXPLICITLY DISABLED OR RELAXED RULES -->
    
    <!-- No Javadocs required -->
    <!-- JavadocPackage, JavadocVariable, MissingJavadocMethod, etc. are NOT included -->

    <!-- Allow non-final parameters -->
    <!-- FinalParameters module is NOT included -->

    <!-- Allow hidden fields (common in setters/constructors) -->
    <!-- HiddenField module is NOT included -->

    <!-- Allow class extension (DesignForExtension) -->
    <!-- DesignForExtension module is NOT included -->

    <!-- Relax Line Length -->
    <module name="LineLength">
      <property name="max" value="160"/>
    </module>

    <!-- Allow tabs in files -->
    <!-- FileTabCharacter is a Checker module, not TreeWalker -->

  </module>
</module>
